@model JobApplicationTracker.Models.JobApplication

@{
    ViewData["Title"] = "Delete Application";
}

<h1>Delete Application</h1>

<div class="alert alert-danger">
    <h4>Are you sure you want to delete this application?</h4>
    <p>This action cannot be undone.</p>
</div>

<div class="card">
    <div class="card-body">

        <h4>@Model.Company</h4>

        <p>
            <strong>Position:</strong>
            @Model.Position
        </p>

        <p>
            <strong>Status:</strong>
            @Model.Status
        </p>

        <form asp-action="Delete" method="post">

            <input type="hidden"
                   asp-for="Id" />

            <button type="submit"
                    class="btn btn-danger">
                Yes, Delete
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>
