@model JobApplicationTracker.Models.JobApplication

@{
    ViewData["Title"] = "Application Details";
}

<h1>Application Details</h1>

<div class="card">
    <div class="card-body">

        <h4>@Model.Company</h4>

        <hr />

        <dl class="row">

            <dt class="col-sm-3">
                Position
            </dt>

            <dd class="col-sm-9">
                @Model.Position
            </dd>

            <dt class="col-sm-3">
                Date Applied
            </dt>

            <dd class="col-sm-9">
                @(Model.DateApplied?.ToString("dd/MM/yyyy") ?? "-")
            </dd>

            <dt class="col-sm-3">
                Status
            </dt>

            <dd class="col-sm-9">
                @Model.Status
            </dd>

            <dt class="col-sm-3">
                Location
            </dt>

            <dd class="col-sm-9">
                @(Model.Location ?? "-")
            </dd>

            <dt class="col-sm-3">
                Notes
            </dt>

            <dd class="col-sm-9">
                @(Model.Notes ?? "-")
            </dd>

        </dl>

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning">
            Edit
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>

    </div>
</div>